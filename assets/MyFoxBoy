<svg width="500" height="700" viewBox="0 0 500 700" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Maska wycinająca fizyczną "dziurę" na środku konsoli -->
    <mask id="screen-hole">
      <rect x="0" y="0" width="100%" height="100%" fill="white" />
      <rect x="110" y="110" width="280" height="200" rx="4" ry="4" fill="black" />
    </mask>
  </defs>

  <!-- Główna obudowa poddana maskowaniu (wycinaniu) -->
  <g mask="url(#screen-hole)">
    <!-- Pomarańczowa bryła konsoli -->
    <rect x="50" y="50" width="400" height="600" rx="20" ry="20" fill="#f97316" stroke="#111827" stroke-width="6" />
    <!-- Szara ramka dookoła ekranu -->
    <rect x="80" y="80" width="340" height="280" rx="12" ry="12" fill="#9ca3af" stroke="#111827" stroke-width="5" />
  </g>

  <!-- Wewnętrzna czarna ramka obrysowująca wyciętą przezroczystą dziurę na grę -->
  <rect x="110" y="110" width="280" height="200" rx="4" ry="4" fill="none" stroke="#111827" stroke-width="5" />

  <!-- Napis "My FoxBoy" na obudowie -->
  <text x="250" y="340" font-family="&#39;Comic Sans MS&#39;, &#39;Chalkboard SE&#39;, cursive, sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="2">My FoxBoy</text>

  <!-- LOGO: Lisek z pikselowymi okularami wstawiony pośrodku -->
  

  <!-- Krzyżak (D-Pad) - idealnie zbalansowany po lewej stronie (środek X=130, Y=455) -->
  <g transform="translate(130, 455)">
    <!-- Zielony D-Pad -->
    <path d="M -15 -15 v -30 h 30 v 30 h 30 v 30 h -30 v 30 h -30 v -30 h -30 v -30 z" fill="#22c55e" stroke="#111827" stroke-width="4" stroke-linejoin="round" />
    <!-- Wytłoczenia na krzyżaku -->
    <polygon points="0,-35 -5,-27 5,-27" fill="#14532d" />
    <polygon points="0,35 -5,27 5,27" fill="#14532d" />
    <polygon points="-35,0 -27,-5 -27,5" fill="#14532d" />
    <polygon points="35,0 27,-5 27,5" fill="#14532d" />
    <circle cx="0" cy="0" r="4" fill="#14532d" opacity="0.8" />
  </g>

  <!-- Przyciski akcji (A, B) - idealnie zbalansowane po prawej stronie (środek X=370, Y=455) -->
  <g transform="translate(400, 425)">
    <circle cx="0" cy="0" r="28" fill="#0ea5e9" stroke="#111827" stroke-width="4" />
    <text x="0" y="8" font-family="Arial, sans-serif" font-weight="bold" font-size="24" fill="#0c4a6e" text-anchor="middle">B</text>
  </g>
  <g transform="translate(340, 485)">
    <circle cx="0" cy="0" r="28" fill="#0ea5e9" stroke="#111827" stroke-width="4" />
    <text x="0" y="8" font-family="Arial, sans-serif" font-weight="bold" font-size="24" fill="#0c4a6e" text-anchor="middle">A</text>
  </g>

  <!-- Przyciski systemowe (Reset, Start) - idealnie symetryczne względem pionowej osi -->
  <g transform="translate(185, 575)">
    <rect x="0" y="0" width="50" height="16" rx="8" ry="8" fill="#111827" />
    <text x="25" y="32" font-family="sans-serif" font-size="12" font-weight="bold" fill="#78350f" text-anchor="middle">RESET</text>
  </g>
  <g transform="translate(265, 575)">
    <rect x="0" y="0" width="50" height="16" rx="8" ry="8" fill="#111827" />
    <text x="25" y="32" font-family="sans-serif" font-size="12" font-weight="bold" fill="#78350f" text-anchor="middle">START</text>
  </g>

  <!-- Głośnik (Kreski) -->
  <g transform="translate(370, 590)">
    <line x1="0" y1="0" x2="30" y2="30" stroke="#111827" stroke-width="5" stroke-linecap="round" />
    <line x1="20" y1="-10" x2="50" y2="20" stroke="#111827" stroke-width="5" stroke-linecap="round" />
    <line x1="40" y1="-20" x2="70" y2="10" stroke="#111827" stroke-width="5" stroke-linecap="round" />
  </g>
</svg>